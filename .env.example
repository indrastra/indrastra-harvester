# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=IndraStra Harvester
APP_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
API_V1_PREFIX=/api/v1

# Bind development ports to loopback; place a TLS reverse proxy in front for production.
API_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
OPENSEARCH_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=harvester
POSTGRES_USER=harvester
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://harvester:change-me@db:5432/harvester

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=scholarly-records
# Optional for secured OpenSearch deployments:
# OPENSEARCH_USERNAME=harvester
# OPENSEARCH_PASSWORD=replace-with-a-secret

OAI_DEFAULT_TIMEOUT_SECONDS=30
OAI_MAX_RESPONSE_BYTES=20000000
OAI_USER_AGENT=IndraStra-Harvester/0.3
